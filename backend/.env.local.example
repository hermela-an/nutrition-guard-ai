APP_PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nutritionguard
DB_SCHEMA=public
DB_USER=postgres
DB_PASSWORD=postgres
JWT_SECRET=replace-with-strong-secret
# Optional: comma-separated emails that should be treated as ADMIN on login/register.
# Example: ADMIN_EMAILS=admin@nutritionguard.local
ADMIN_EMAILS=

FRONTEND_BASE_URL=http://localhost:4200
PASSWORD_RESET_TTL_MINUTES=20

# You can keep shared settings (like SMTP) in `.env` and override only local DB values here.
# The backend loads both `.env` and `.env.local` (when present), with `.env.local` taking precedence.
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@nutritionguard.local

# RAG (Retrieval-Augmented Generation) service URL.
# Points to a Python FAISS vector search service that retrieves deep domain knowledge from nutrition PDFs.
# Default: http://localhost:5000/query
# RAG_API_URL=http://localhost:5000/query
