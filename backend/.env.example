APP_PORT=8080
DB_HOST=localhost
DB_PORT=5433
DB_NAME=nutritionguard
DB_SCHEMA=public
DB_USER=nutritionguard
DB_PASSWORD=nutritionguard
JWT_SECRET=replace-with-strong-secret
# Optional: comma-separated emails that should be treated as ADMIN on login/register.
# Example: ADMIN_EMAILS=admin@nutritionguard.local,teacher@nutritionguard.local
ADMIN_EMAILS=

# Frontend URL used to build password reset links.
FRONTEND_BASE_URL=http://localhost:4200

# Password reset token lifetime (minutes). Recommended 15-30.
PASSWORD_RESET_TTL_MINUTES=20

# SMTP settings (optional). If SMTP_HOST is empty, reset emails won't be sent (server logs a notice instead).
# Gmail example: use an App Password (not your normal Gmail password).
# Note: Gmail app passwords are shown with spaces (e.g. "abcd efgh ijkl mnop") but should be pasted WITHOUT spaces.
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@nutritionguard.local
